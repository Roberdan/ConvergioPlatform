{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist/tests",
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
